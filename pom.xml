<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.fitanalizer</groupId>
    <artifactId>fit-analizer</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>fit-analizer</name>
    <description>Backend que analisa fit entre vaga de emprego e perfil técnico via Claude API</description>

    <properties>
        <java.version>21</java.version>
        <!-- Sobrescreve a versão do Testcontainers gerenciada pelo Spring Boot 3.3.4
             (1.19.8). As 1.x usam uma API do Docker antiga que o Docker Engine 29+
             recusa ("client version 1.32 is too old"); a 2.x negocia a versão da
             API sozinha, sem depender de ~/.docker-java.properties em cada máquina.
             Na 2.x os módulos foram renomeados (prefixo "testcontainers-"). -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!-- Tags JUnit fora do `mvn test` normal. "regressao" chama a Claude API
             real e gasta crédito (RegressaoPromptTest). Como propriedade, e não
             fixo no plugin, para poder ser zerada na linha de comando:
             ./mvnw test -Dgroups=regressao -DexcludedGroups= -Dtest=RegressaoPromptTest
             Só -Dgroups=regressao não basta: a exclusão venceria e nada rodaria. -->
        <excludedGroups>regressao</excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- SDK oficial da Claude API (Spec F02, seção 1.1) — versão a conferir
             contra a mais recente em https://central.sonatype.com/artifact/com.anthropic/anthropic-java
             no momento do build, pode ter saído uma mais nova. -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>2.66.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Postgres real nos testes de integração do dedup (versão vem da
             propriedade testcontainers.version acima, via BOM do Spring Boot). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- O ByteBuddy embutido no Mockito/Spring Boot 3.3.4 ainda não
                         suporta bytecode do Java 25 (só até Java 23); afeta só o
                         "inline mock maker" usado por @MockBean (ProfileControllerTest),
                         não o @Mock simples do ProfileServiceTest. Isso é um problema
                         de JDK de execução dos testes (ex: Codespaces vem com JDK 25 por
                         padrão), não do bytecode compilado; o projeto continua
                         compilando com release 21. Flag oficial do ByteBuddy pra
                         tentar mesmo em JDK não oficialmente suportado. Remover quando
                         o Spring Boot atualizar pra uma versão de ByteBuddy com suporte
                         nativo ao Java 25. -->
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
